{
  "manifest_version": 3,
  "name": "Claude Clip",
  "version": "0.1.0",
  "description": "Queue text from any page so it attaches to your next Claude Code prompt.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude Clip",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "send-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Send selected text to Claude Code"
    }
  }
}
